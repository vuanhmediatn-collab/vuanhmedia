{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "admin.vuanhmedia.com"
        }
      ],
      "destination": "https://www.vuanhmedia.com/admin",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "admin.vuanhmedia.com"
        }
      ],
      "destination": "https://www.vuanhmedia.com/admin/:path*",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "vuanhmedia.com"
        }
      ],
      "destination": "https://www.vuanhmedia.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "vuanhmedia.com"
        }
      ],
      "destination": "https://www.vuanhmedia.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/command-center/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/command-center",
      "destination": "/command-center/index.html"
    },
    {
      "source": "/command-center/",
      "destination": "/command-center/index.html"
    },
    {
      "source": "/vamops",
      "destination": "/command-center/index.html"
    },
    {
      "source": "/vamops/",
      "destination": "/command-center/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
